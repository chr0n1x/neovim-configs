FROM alpine:latest

ENV DEBIAN_FRONTEND=noninteractive

# Install Neovim, static analysis tools, and build essentials
RUN apk add --no-cache \
    bash \
    neovim \
    git \
    make \
    luacheck \
    stylua

# Config is volume-mounted at $XDG_CONFIG_HOME/nvim/ = /nvim-config/nvim/
ENV XDG_CONFIG_HOME=/nvim-config

WORKDIR /nvim-config/nvim

CMD ["make", "test"]
